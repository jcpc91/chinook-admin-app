# Auth Service Environment Variables Template
# Copy this file to .env and fill in the values

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# JWT Configuration
JWT_SECREAT_KEY=your_jwt_secret_key_here

# Service Port
PORT=3000

# Node Environment
NODE_ENV=development

# Database Configuration (Development - SQLite)
DB_TYPE=sqlite3
DB_PATH=../.db/

# Database Configuration (Staging/Production - PostgreSQL)
# DB_TYPE=postgresql
# DB_HOST=postgres
# DB_NAME=chinook_auth
# DB_USER=chinook_user
# DB_PASSWORD=your_db_password_here
# DB_PORT=5432