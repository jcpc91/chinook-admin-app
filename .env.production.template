# Production Environment Variables Template
# Copy this file to .env.production and update with your production-specific values
# SECURITY WARNING: Use strong, unique values for production!

# JWT Configuration (minimum 32 characters)
# Generate with: openssl rand -hex 32
JWT_SECREAT_KEY=your_production_jwt_secret_key_minimum_32_characters

# Database Configuration
DB_USER=chinook_user
# Generate with: openssl rand -base64 32
DB_PASSWORD=your_secure_production_db_password_minimum_16_characters

# CORS Configuration (update with your production domain)
# IMPORTANT: Use HTTPS URLs for production
CORS_ORIGIN=https://your-production-domain.com,https://www.your-production-domain.com

# Logging Configuration (production optimized)
LOG_LEVEL=warn
LOG_FORMAT=json
ENABLE_REQUEST_LOGGING=false

# Rate Limiting Configuration (production values)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS_AUTH=100
RATE_LIMIT_MAX_REQUESTS_APP=1000
RATE_LIMIT_MAX_REQUESTS_CATALOGOS=500

# Backup Configuration
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *

# Database Pool Configuration (production optimized)
DB_POOL_MIN=5
DB_POOL_MAX=50
DB_TIMEOUT=60000
DB_ACQUIRE_TIMEOUT=60000
DB_IDLE_TIMEOUT=300000

# Security Configuration (production hardened)
TRUST_PROXY=true
SECURE_COOKIES=true
RATE_LIMIT_ENABLED=true
HELMET_ENABLED=true
CSRF_PROTECTION=true

# SSL Configuration (if using HTTPS)
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/private.key
SSL_REDIRECT=true
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000

# Cache Configuration
REDIS_URL=redis://redis:6379
CACHE_TTL=3600
SESSION_STORE=redis

# Monitoring Configuration
PROMETHEUS_ENABLED=true
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL=30
ALERT_WEBHOOK_URL=https://your-monitoring-webhook.com

# Performance Configuration
NODE_ENV=production
COMPRESSION_ENABLED=true
GZIP_LEVEL=6
KEEP_ALIVE_TIMEOUT=65000
BODY_PARSER_LIMIT=10mb

# Development Features (disabled in production)
ENABLE_DEBUG=false
ENABLE_PROFILING=false
ENABLE_SWAGGER=false

# Optional: External Service URLs
# EXTERNAL_API_URL=https://api.external-service.com
# WEBHOOK_URL=https://your-webhook-endpoint.com

# Optional: Email Configuration (if needed)
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# FROM_EMAIL=noreply@your-domain.com

# Optional: File Storage Configuration
# STORAGE_TYPE=local
# UPLOAD_PATH=/app/uploads
# MAX_FILE_SIZE=10485760

# Optional: Analytics Configuration
# ANALYTICS_ENABLED=true
# GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX