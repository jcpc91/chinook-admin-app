# Staging Environment Configuration
# All services containerized with PostgreSQL
VITE_MODE=staging
VITE_BASE_URL=http://app:3001
VITE_URL_AUTH=http://auth:3000

# Container-specific settings
VITE_PORT=5173
VITE_PREVIEW_PORT=4173
VITE_USE_PROXY=false

# CORS settings for staging
VITE_CORS_ORIGIN=http://web:5173

# API timeout settings (in milliseconds)
VITE_API_TIMEOUT=15000
VITE_AUTH_TIMEOUT=8000

# Additional staging-specific variables
VITE_CATALOGOS_URL=http://catalogos:3002
VITE_ENABLE_DEBUG=false
VITE_LOG_LEVEL=warn