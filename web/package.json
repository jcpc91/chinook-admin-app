{
  "name": "chinookadminapp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:unit:container": "vitest --config=vitest.config.container.js",
    "test:e2e": "playwright test",
    "test:e2e:dev": "playwright test --config=playwright.config.dev.js",
    "test:e2e:staging": "playwright test --config=playwright.config.staging.js",
    "test:e2e:production": "playwright test --config=playwright.config.production.js",
    "test:integration": "npm run test:e2e:dev && npm run test:e2e:staging",
    "test:integration:all": "npm run test:e2e:dev && npm run test:e2e:staging && npm run test:e2e:production",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix",
    "lint": "run-s lint:*",
    "format": "prettier --write src/",
    "env:validate": "node scripts/validate-env.js",
    "env:validate:dev": "node scripts/validate-env.js .env.development desarrollo",
    "env:validate:staging": "node scripts/validate-env.js .env.staging staging",
    "env:validate:prod": "node scripts/validate-env.js .env.production production",
    "env:inject": "node scripts/inject-env.js",
    "build:dev": "npm run env:validate:dev && vite build --mode development",
    "build:staging": "npm run env:validate:staging && vite build --mode staging",
    "build:prod": "npm run env:validate:prod && vite build --mode production"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@vueuse/core": "^13.3.0",
    "pinia": "^3.0.1",
    "tailwindcss": "^4.1.4",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vue3-easy-data-table": "^1.5.47"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@pinia/testing": "^1.0.2",
    "@playwright/test": "^1.51.1",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vitest/eslint-plugin": "^1.1.39",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.4.6",
    "chance": "^1.1.13",
    "eslint": "^9.22.0",
    "eslint-plugin-oxlint": "^0.16.0",
    "eslint-plugin-playwright": "^2.2.0",
    "eslint-plugin-vue": "~10.0.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "npm-run-all2": "^7.0.2",
    "oxlint": "^0.16.0",
    "prettier": "3.5.3",
    "vite": "^6.2.4",
    "vite-plugin-vue-devtools": "^7.7.2",
    "vitest": "^3.2.4"
  }
}
