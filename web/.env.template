# Environment Configuration Template
# Copy this file to .env.development, .env.staging, or .env.production
# and customize the values for your specific environment

# Application mode (desarrollo, staging, production)
VITE_MODE=desarrollo

# API endpoints - adjust based on your deployment
VITE_BASE_URL=http://localhost:3001
VITE_URL_AUTH=http://localhost:3000
VITE_CATALOGOS_URL=http://localhost:3002

# Container-specific settings
VITE_PORT=5173
VITE_PREVIEW_PORT=4173
VITE_USE_PROXY=false

# CORS settings - comma-separated list of allowed origins
VITE_CORS_ORIGIN=http://localhost:5173

# API timeout settings (in milliseconds)
VITE_API_TIMEOUT=10000
VITE_AUTH_TIMEOUT=5000

# Debug and logging settings
VITE_ENABLE_DEBUG=false
VITE_LOG_LEVEL=info

# Security settings (for production)
VITE_SECURE_COOKIES=false
VITE_ENABLE_HTTPS=false