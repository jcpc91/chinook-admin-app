# Development Environment Variables Template
# Copy this file to .env and fill in the values

# JWT Configuration
JWT_SECREAT_KEY=your_development_jwt_secret_key_here

# Database Configuration (SQLite for development)
DB_TYPE=sqlite3
DB_PATH=./.db/

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Service Ports
AUTH_PORT=3000
APP_PORT=3001
CATALOGOS_PORT=3002
WEB_PORT=5173

# Web Frontend Configuration
VITE_MODE=desarrollo
VITE_BASE_URL=http://localhost:3001
VITE_URL_AUTH=http://localhost:3000