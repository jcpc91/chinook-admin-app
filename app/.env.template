# App Service Environment Variables Template
# Copy this file to .env and fill in the values

# CORS Configuration
# Development: Frontend running locally or in container
CORS_ORIGIN=http://localhost:5173

# JWT Configuration
JWT_SECREAT_KEY=your_jwt_secret_key_here

# Service Port
PORT=3001

# Node Environment
NODE_ENV=development

# Database Configuration (Development - SQLite)
DB_TYPE=sqlite3
DB_PATH=../.db/

# Database Configuration (Staging/Production - PostgreSQL)
# Uncomment and configure for containerized environments
# DB_TYPE=postgresql
# DB_HOST=postgres
# DB_NAME=chinook_app
# DB_USER=chinook_user
# DB_PASSWORD=your_db_password_here
# DB_PORT=5432

# Service-to-Service Communication (Containerized Environments)
# These are used when services communicate within Docker network
# Development: Use host.docker.internal for mixed local/container setup
# Staging/Production: Use container service names
# AUTH_SERVICE_URL=http://auth:3000
# CATALOGOS_SERVICE_URL=http://catalogos:3002