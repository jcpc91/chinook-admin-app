# App Service - Production Environment Configuration

# CORS Configuration - Allow web container access
CORS_ORIGIN=http://web:5173

# JWT Configuration
JWT_SECREAT_KEY=${JWT_SECRET}

# Service Port
PORT=3001

# Node Environment
NODE_ENV=production

# Database Configuration - PostgreSQL Container
DB_TYPE=postgresql
DB_HOST=postgres
DB_NAME=chinook_app
DB_USER=${DB_USER}
DB_PASSWORD=${DB_PASSWORD}
DB_PORT=5432

# Service-to-Service Communication
AUTH_SERVICE_URL=http://auth:3000
CATALOGOS_SERVICE_URL=http://catalogos:3002