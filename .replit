modules = ["vue-node-20", "nodejs-20", "web"]

run = "./run.sh"

[nix]
channel = "stable-24_05"
packages = ["sqlite"]

[deployment]
run = ["sh", "-c", "npm run dev"]

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 3002
externalPort = 3002

[[ports]]
localPort = 3003
externalPort = 3003

[[ports]]
localPort = 5173
externalPort = 5173

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Full Stack Dev"
author = 24863620
mode = "parallel"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run app:dev"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run auth:dev"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run catalogos:dev"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run inversiones:dev"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run web:dev"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Vue Frontend"

[[workflows.workflow]]
name = "Vue Frontend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run web:dev"
waitForPort = 3003

[workflows.workflow.metadata]
outputType = "console"

[agent]
expertMode = true
