# Docker Compose Environment Variables Template
# Copy this file to .env and customize the values for your deployment

# Database Configuration
DB_USER=chinook_user
DB_PASSWORD=your_secure_password_here

# JWT Configuration
JWT_SECREAT_KEY=your_jwt_secret_key_here

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGIN=http://localhost:5173,http://web:5173

# Web Service Environment Variables
# These will be injected into the web container at build time and runtime

# Development Environment (docker-compose.dev.yml)
VITE_MODE_DEV=desarrollo
VITE_BASE_URL_DEV=http://host.docker.internal:3001
VITE_URL_AUTH_DEV=http://host.docker.internal:3000
VITE_CATALOGOS_URL_DEV=http://host.docker.internal:3002
VITE_CORS_ORIGIN_DEV=http://localhost:5173,http://host.docker.internal:5173,http://127.0.0.1:5173

# Staging Environment (docker-compose.staging.yml)
VITE_MODE_STAGING=staging
VITE_BASE_URL_STAGING=http://app:3001
VITE_URL_AUTH_STAGING=http://auth:3000
VITE_CATALOGOS_URL_STAGING=http://catalogos:3002
VITE_CORS_ORIGIN_STAGING=http://web:5173,http://localhost:80

# Production Environment (docker-compose.prod.yml)
VITE_MODE_PROD=production
VITE_BASE_URL_PROD=http://app:3001
VITE_URL_AUTH_PROD=http://auth:3000
VITE_CATALOGOS_URL_PROD=http://catalogos:3002
VITE_CORS_ORIGIN_PROD=http://web:80,https://web:443

# Optional Web Configuration (applies to all environments unless overridden)
VITE_PORT=5173
VITE_PREVIEW_PORT=4173
VITE_API_TIMEOUT=10000
VITE_AUTH_TIMEOUT=5000
VITE_ENABLE_DEBUG=false
VITE_LOG_LEVEL=info

# Production-specific Security Settings
VITE_SECURE_COOKIES_PROD=true
VITE_ENABLE_HTTPS_PROD=true