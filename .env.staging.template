# Staging Environment Variables Template
# Copy this file to .env.staging and update with your staging-specific values

# JWT Configuration (minimum 32 characters)
# Generate with: openssl rand -hex 32
JWT_SECREAT_KEY=your_staging_jwt_secret_key_minimum_32_characters

# Database Configuration
DB_USER=chinook_user
# Generate with: openssl rand -base64 24
DB_PASSWORD=your_staging_db_password_minimum_16_characters

# CORS Configuration (update with your staging domain)
CORS_ORIGIN=http://localhost:80,http://your-staging-domain.com

# Logging Configuration
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Optional: Backup Configuration
BACKUP_RETENTION_DAYS=7

# Optional: Database Pool Configuration
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_TIMEOUT=30000

# Optional: Service URLs (usually auto-configured)
# AUTH_SERVICE_URL=http://auth:3000
# APP_SERVICE_URL=http://app:3001
# CATALOGOS_SERVICE_URL=http://catalogos:3002

# Optional: Monitoring Configuration
# PROMETHEUS_ENABLED=true
# METRICS_PORT=9090

# Optional: Cache Configuration
# REDIS_URL=redis://redis:6379
# CACHE_TTL=3600

# Security Configuration
TRUST_PROXY=false
SECURE_COOKIES=false
RATE_LIMIT_ENABLED=true

# Development Features (disable in production)
ENABLE_DEBUG=false
ENABLE_PROFILING=false