# Staging Environment Configuration
# This file contains the environment variables for the staging Docker Compose setup

# JWT Configuration - CHANGE THIS IN PRODUCTION
JWT_SECREAT_KEY=staging_jwt_secret_key_change_in_production_environment

# Database Configuration
DB_USER=chinook_user
DB_PASSWORD=secure_staging_password_change_me

# Node Environment
NODE_ENV=staging

# Service Ports (internal container ports)
AUTH_PORT=3000
APP_PORT=3001
CATALOGOS_PORT=3002
WEB_PORT=5173

# Database Connection Pool Settings
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_TIMEOUT=30000

# Logging Configuration
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true

# CORS Configuration
CORS_ORIGIN=http://web:5173,http://localhost:80

# Web Frontend Configuration (Vite)
VITE_MODE=staging
VITE_BASE_URL=http://app:3001
VITE_URL_AUTH=http://auth:3000
VITE_CATALOGOS_URL=http://catalogos:3002
VITE_PORT=5173
VITE_PREVIEW_PORT=4173
VITE_USE_PROXY=false
VITE_CORS_ORIGIN=http://web:5173
VITE_API_TIMEOUT=15000
VITE_AUTH_TIMEOUT=8000
VITE_ENABLE_DEBUG=false
VITE_LOG_LEVEL=warn
VITE_SECURE_COOKIES=false
VITE_ENABLE_HTTPS=false

# PostgreSQL Configuration
POSTGRES_DB=chinook
POSTGRES_USER=chinook_user
POSTGRES_PASSWORD=secure_staging_password_change_me
POSTGRES_INITDB_ARGS=--encoding=UTF-8 --lc-collate=C --lc-ctype=C

# Service Communication URLs (internal Docker network)
AUTH_SERVICE_URL=http://auth:3000
APP_SERVICE_URL=http://app:3001
CATALOGOS_SERVICE_URL=http://catalogos:3002

# Database Names for Each Service
DB_NAME_AUTH=chinook_auth
DB_NAME_APP=chinook_app
DB_NAME_CATALOGOS=chinook_catalogos