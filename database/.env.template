# Database Service Environment Variables Template
# Copy this file to .env and fill in the values

# Node Environment
NODE_ENV=development

# Database Configuration (Development - SQLite)
DB_TYPE=sqlite3
DB_PATH=../.db/

# Database Configuration (Staging/Production - PostgreSQL)
# DB_TYPE=postgresql
# DB_HOST=postgres
# DB_NAME=chinook
# DB_USER=chinook_user
# DB_PASSWORD=your_db_password_here
# DB_PORT=5432

# Migration Configuration
MIGRATION_TIMEOUT=30000
MIGRATION_BATCH_SIZE=100