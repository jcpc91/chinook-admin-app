# Production Environment Variables
# IMPORTANT: Change all default values before deploying to production!

# JWT Configuration - CHANGE THIS IN PRODUCTION!
JWT_SECREAT_KEY=production_jwt_secret_key_minimum_32_characters_change_this

# Database Configuration - CHANGE THESE IN PRODUCTION!
DB_USER=chinook_user
DB_PASSWORD=secure_production_db_password_change_this

# CORS Configuration - UPDATE WITH YOUR PRODUCTION DOMAIN!
CORS_ORIGIN=https://your-production-domain.com,https://www.your-production-domain.com

# Backup Configuration
BACKUP_RETENTION_DAYS=30

# Logging Configuration
LOG_LEVEL=warn
LOG_FORMAT=json

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS_AUTH=100
RATE_LIMIT_MAX_REQUESTS_APP=1000
RATE_LIMIT_MAX_REQUESTS_CATALOGOS=500

# Security Configuration
SECURE_COOKIES=true
TRUST_PROXY=true

# SSL Configuration (if using custom certificates)
# SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
# SSL_KEY_PATH=/etc/nginx/ssl/private.key

# Monitoring Configuration
ENABLE_METRICS=true
METRICS_PORT=9090

# Performance Configuration
DB_POOL_MIN=5
DB_POOL_MAX=50
DB_TIMEOUT=60000
DB_ACQUIRE_TIMEOUT=60000
DB_IDLE_TIMEOUT=300000

# Web Frontend Production Configuration
VITE_MODE=production
VITE_BASE_URL=http://app:3001
VITE_URL_AUTH=http://auth:3000
VITE_CATALOGOS_URL=http://catalogos:3002
VITE_PORT=80
VITE_PREVIEW_PORT=80
VITE_USE_PROXY=false
VITE_API_TIMEOUT=30000
VITE_AUTH_TIMEOUT=15000
VITE_ENABLE_DEBUG=false
VITE_LOG_LEVEL=error
VITE_SECURE_COOKIES=true
VITE_ENABLE_HTTPS=true
VITE_CSP_ENABLED=true
VITE_HSTS_ENABLED=true

# Nginx Configuration
NGINX_WORKER_PROCESSES=auto
NGINX_WORKER_CONNECTIONS=1024
NGINX_KEEPALIVE_TIMEOUT=65
NGINX_CLIENT_MAX_BODY_SIZE=10m
NGINX_GZIP_ENABLED=true
NGINX_BROTLI_ENABLED=true